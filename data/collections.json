{
  "_comment": "Series folders. One card in the grid stands for the whole series, so a 53-entry mod series doesn't bury everything else. Genres are NOT collections — those stay tag filters. `match` is a case-insensitive regex on the title; `only` pins explicit ids when a regex would be too blunt.",
  "collections": [
    { "id": "fnf",           "title": "Friday Night Funkin'", "match": "friday night funkin|^fnf\\b" },
    { "id": "fnaf",          "title": "Five Nights at Freddy's", "match": "five nights at freddy|^fnaf\\b" },
    { "id": "papas",         "title": "Papa's",              "match": "^papa.?s " },
    { "id": "minecraft",     "title": "Minecraft",           "match": "minecraft|eaglercraft" },
    { "id": "sonic",         "title": "Sonic",               "match": "\\bsonic\\b" },
    { "id": "mario",         "title": "Mario",               "match": "\\bmario\\b" },
    { "id": "granny",        "title": "Granny",              "match": "^granny" },
    { "id": "baldi",         "title": "Baldi's Basics",      "match": "baldi" },
    { "id": "cut-the-rope",  "title": "Cut the Rope",        "match": "cut the rope" },
    { "id": "angry-birds",   "title": "Angry Birds",         "match": "angry birds" },
    { "id": "geometry-dash", "title": "Geometry Dash",       "match": "geometry dash" },
    { "id": "retro-bowl",    "title": "Retro Bowl",          "match": "retro bowl" },
    { "id": "slope",         "title": "Slope",               "match": "^slope" },
    { "id": "run",           "title": "Run",                 "match": "^run [0-9]|^run$" },
    { "id": "doom",          "title": "Doom",                "match": "^doom" },
    { "id": "tetris",        "title": "Tetris",              "match": "tetris" },
    { "id": "bloons",        "title": "Bloons",              "match": "bloons|btd" },
    { "id": "henry-stickmin","title": "Henry Stickmin",      "match": "henry stickmin|stickmin" },
    { "id": "duck-life",     "title": "Duck Life",           "match": "duck life" },
    { "id": "moto-x3m",      "title": "Moto X3M",            "match": "moto x3m" },
    { "id": "vex",           "title": "Vex",                 "match": "^vex ?[0-9]?$" },
    { "id": "madness",       "title": "Madness Combat",      "match": "madness" },
    { "id": "riddle-school", "title": "Riddle School",       "match": "riddle school|riddle transfer" },
    { "id": "learn-to-fly",  "title": "Learn to Fly",        "match": "learn to fly" },
    { "id": "happy-wheels",  "title": "Happy Wheels",        "match": "happy wheels" }
  ]
}
